PORT=4000
SQLITE_DB_PATH=../seminars.db

# Gmail SMTP (use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587            # 587 with STARTTLS (recommended) or 465 with SSL
SMTP_SECURE=false        # true for port 465, false for 587
SMTP_REQUIRE_TLS=true    # enforce TLS upgrade
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Seminar Organizer
# Optional: use Gmail basic auth (service shortcut)
SMTP_SERVICE=gmail

COORDINATOR_EMAIL=
COORDINATOR_NAME=

# Session/cookie settings
# Change this in production
SESSION_SECRET=replace-with-a-long-random-secret
# Set true when serving over HTTPS (recommended behind a reverse proxy)
COOKIE_SECURE=false
COOKIE_NAME=sid
COOKIE_SAMESITE=lax
